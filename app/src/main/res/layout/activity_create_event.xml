<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F3D3E">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:orientation="vertical"
            android:background="#134E4A"
            android:padding="20dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Event"
                android:textColor="#E6FFFA"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fill details to publish event"
                android:textColor="#99F6E4"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- FORM CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="-30dp"
            android:background="#1F6F6E">

            <!-- TITLE -->
            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Event Title"
                android:textColor="#FFFFFF"
                android:textColorHint="#A7F3D0"
                android:background="#134E4A"
                android:padding="12dp" />

            <!-- CATEGORY -->
            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="#134E4A"
                android:padding="10dp" />

            <!-- DESCRIPTION -->
            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="10dp"
                android:hint="Description"
                android:textColor="#FFFFFF"
                android:textColorHint="#A7F3D0"
                android:background="#134E4A"
                android:padding="12dp" />

            <!-- DATE -->
            <EditText
                android:id="@+id/etDate"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:hint="Select Date"
                android:textColor="#FFFFFF"
                android:textColorHint="#A7F3D0"
                android:background="#134E4A"
                android:padding="12dp"
                android:focusable="false"
                android:clickable="true" />

            <!-- TIME -->
            <EditText
                android:id="@+id/etTime"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:hint="Time"
                android:textColor="#FFFFFF"
                android:textColorHint="#A7F3D0"
                android:background="#134E4A"
                android:padding="12dp"

                android:focusable="false"
                android:clickable="true"/>

            <!-- VENUE -->
            <EditText
                android:id="@+id/etVenue"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:hint="Venue"
                android:textColor="#FFFFFF"
                android:textColorHint="#A7F3D0"
                android:background="#134E4A"
                android:padding="12dp" />

            <!-- MAX PARTICIPANTS -->
            <EditText
                android:id="@+id/etMax"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:hint="Max Participants"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textColorHint="#A7F3D0"
                android:background="#134E4A"
                android:padding="12dp" />

            <!-- RULES -->
            <EditText
                android:id="@+id/etRules"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:hint="Rules"
                android:textColor="#FFFFFF"
                android:textColorHint="#A7F3D0"
                android:background="#134E4A"
                android:padding="12dp" />

            <!-- GUIDELINES -->
            <EditText
                android:id="@+id/etGuidelines"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:hint="Guidelines"
                android:textColor="#FFFFFF"
                android:textColorHint="#A7F3D0"
                android:background="#134E4A"
                android:padding="12dp" />

            <!-- UPLOAD BUTTON -->
            <Button
                android:id="@+id/btnUploadImage"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="Upload Image"
                android:textColor="#000000"
                android:backgroundTint="#F59E0B" />

            <!-- CAMERA BUTTON -->
            <Button
                android:id="@+id/btnCamera"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="Capture Image"
                android:textColor="#FFFFFF"
                android:backgroundTint="#14B8A6" />

            <!-- IMAGE PREVIEW -->
            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="10dp"
                android:background="#0F3D3E"
                android:scaleType="centerCrop" />

            <!-- SUBMIT -->
            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                android:text="Create Event"
                android:textColor="#000000"
                android:textStyle="bold"
                android:backgroundTint="#F59E0B" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>